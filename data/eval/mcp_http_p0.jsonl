{"id": "http-json-basic", "category": "transport", "description": "JSON 响应：暴露两个工具与 session_probe，schema 子集外与白名单外的工具带固定跳过码，调用成功", "runs": [{"expect_exposed": ["echo_query", "lookup_project", "session_probe"], "expect_skips": {"nested_schema_tool": "MCP_UNSUPPORTED_SCHEMA", "unlisted_tool": "MCP_NOT_IN_ALLOWLIST"}, "calls": [{"tool": "echo_query", "args": {"query": "管径"}, "expect_ok": true, "expect_contains": "管径"}], "expect_server": {"initialize_count": 1, "tools_call_processed": 1}}]}
{"id": "http-sse-basic", "category": "transport", "description": "SSE 响应：同上，响应在事件流里", "server": {"mode": "sse"}, "runs": [{"expect_exposed": ["echo_query", "lookup_project", "session_probe"], "expect_skips": {"nested_schema_tool": "MCP_UNSUPPORTED_SCHEMA", "unlisted_tool": "MCP_NOT_IN_ALLOWLIST"}, "calls": [{"tool": "echo_query", "args": {"query": "管径"}, "expect_ok": true, "expect_contains": "管径"}], "expect_server": {"initialize_count": 1, "tools_call_processed": 1}}]}
{"id": "http-allow-empty", "category": "transport", "description": "allow 未配置：全部工具跳过 MCP_NOT_IN_ALLOWLIST，不暴露任何工具", "config": {"allow": null}, "runs": [{"expect_exposed": [], "expect_skips": {"echo_query": "MCP_NOT_IN_ALLOWLIST", "lookup_project": "MCP_NOT_IN_ALLOWLIST", "session_probe": "MCP_NOT_IN_ALLOWLIST", "nested_schema_tool": "MCP_NOT_IN_ALLOWLIST", "unlisted_tool": "MCP_NOT_IN_ALLOWLIST"}}]}
{"id": "http-disabled", "category": "transport", "description": "disabled=true：不连接、不暴露，假 server 一个请求都没收到", "config": {"disabled": true}, "runs": [{"expect_exposed": [], "expect_skips": {"*": "MCP_SERVER_DISABLED"}, "expect_server": {"no_requests": true}}]}
{"id": "http-poisoned-description", "category": "transport", "description": "工具描述被投毒：该工具 MCP_DESCRIPTION_UNSAFE，不脱敏放行", "server": {"mode": "poisoned"}, "runs": [{"expect_exposed": ["lookup_project", "session_probe"], "expect_skips": {"nested_schema_tool": "MCP_UNSUPPORTED_SCHEMA", "unlisted_tool": "MCP_NOT_IN_ALLOWLIST", "echo_query": "MCP_DESCRIPTION_UNSAFE"}}]}
{"id": "http-session-expire-rebuild", "category": "protocol", "description": "会话被 server 终止（404）：重新 initialize 一次后继续；被拒的请求不算被处理", "server": {"mode": "session_expire"}, "runs": [{"calls": [{"tool": "session_probe", "expect_ok": true, "expect_fields": {"calls_in_session": 1}}, {"tool": "session_probe", "expect_ok": true, "expect_fields": {"calls_in_session": 1, "initialize_count": 2}}], "expect_server": {"initialize_count": 2, "tools_call_processed": 2}}]}
{"id": "http-bad-content-type", "category": "protocol", "description": "tools/list 的 Content-Type 不是 JSON / SSE：MCP_PROTOCOL_ERROR，整台跳过", "server": {"mode": "bad_content_type"}, "runs": [{"expect_exposed": [], "expect_skips": {"*": "MCP_PROTOCOL_ERROR"}}]}
{"id": "http-flood-response", "category": "protocol", "description": "单条响应超过 max_response_bytes：MCP_RESPONSE_TOO_LARGE", "server": {"mode": "flood"}, "runs": [{"expect_exposed": [], "expect_skips": {"*": "MCP_RESPONSE_TOO_LARGE"}}]}
{"id": "http-redirect-not-followed", "category": "protocol", "description": "307 重定向不跟随：MCP_PROTOCOL_ERROR，重定向目标零请求", "server": {"mode": "redirect"}, "runs": [{"expect_exposed": [], "expect_skips": {"*": "MCP_PROTOCOL_ERROR"}, "expect_server": {"elsewhere_hits": 0}}]}
{"id": "http-server-request-refused", "category": "protocol", "description": "SSE 流里的 server→client 请求被以 MethodNotFound 回绝，调用仍成功", "server": {"mode": "server_request"}, "runs": [{"calls": [{"tool": "echo_query", "args": {"query": "管径"}, "expect_ok": true, "expect_contains": "管径"}], "expect_server": {"method_not_found_reply": true, "tools_call_processed": 1}}]}
{"id": "http-modern-only-server", "category": "protocol", "description": "server 只讲 2026-07-28 无状态协议：MCP_PROTOCOL_UNSUPPORTED，不伪装成网络故障", "server": {"mode": "modern_only"}, "runs": [{"expect_exposed": [], "expect_skips": {"*": "MCP_PROTOCOL_UNSUPPORTED"}}]}
{"id": "http-call-timeout-no-replay", "category": "protocol", "description": "工具调用超时：MCP_TIMEOUT，不自动重发（server 只处理 1 次）", "server": {"mode": "slow"}, "config": {"call_timeout_seconds": 1.0}, "runs": [{"calls": [{"tool": "echo_query", "args": {"query": "x"}, "expect_ok": false, "expect_code": "MCP_TIMEOUT"}], "expect_server": {"tools_call_processed": 1}}]}
{"id": "http-stream-cut-no-replay", "category": "protocol", "description": "SSE 流在收到响应前断开：MCP_CONNECT_FAILED，工具调用不自动重发", "server": {"mode": "sse_cut"}, "runs": [{"calls": [{"tool": "echo_query", "args": {"query": "x"}, "expect_ok": false, "expect_code": "MCP_CONNECT_FAILED"}], "expect_server": {"tools_call_processed": 1}}]}
{"id": "http-ssrf-loopback-denied", "category": "ssrf", "description": "allow_private_network=false：回环地址 MCP_DESTINATION_FORBIDDEN，零请求零连接", "config": {"allow_private_network": false}, "forbidden_ips": ["127.0.0.1"], "forbidden_destination": true, "runs": [{"expect_exposed": [], "expect_skips": {"*": "MCP_DESTINATION_FORBIDDEN"}, "expect_server": {"no_requests": true}}]}
{"id": "http-ssrf-metadata-address", "category": "ssrf", "description": "云元数据地址永远拒绝（即使 allow_private_network=true）", "config": {"host": "169.254.169.254"}, "forbidden_ips": ["169.254.169.254"], "forbidden_destination": true, "runs": [{"expect_exposed": [], "expect_skips": {"*": "MCP_DESTINATION_FORBIDDEN"}, "expect_server": {"no_requests": true}}]}
{"id": "http-ssrf-dns-to-private", "category": "ssrf", "description": "公网域名解析到私有地址：拒绝，零连接", "config": {"host": "internal.test", "allow_private_network": false}, "dns": {"internal.test": ["10.1.2.3"]}, "forbidden_ips": ["10.1.2.3"], "forbidden_destination": true, "runs": [{"expect_exposed": [], "expect_skips": {"*": "MCP_DESTINATION_FORBIDDEN"}, "expect_server": {"no_requests": true}}]}
{"id": "http-ssrf-mixed-answers", "category": "ssrf", "description": "解析出多个地址、其中一个落在回环：整体拒绝，对任何一个都不连接", "config": {"host": "public.test", "allow_private_network": false}, "dns": {"public.test": ["93.184.216.34", "127.0.0.1"]}, "forbidden_ips": ["93.184.216.34", "127.0.0.1"], "forbidden_destination": true, "runs": [{"expect_exposed": [], "expect_skips": {"*": "MCP_DESTINATION_FORBIDDEN"}, "expect_server": {"no_requests": true}}]}
{"id": "http-ssrf-rebinding-pinned", "category": "ssrf", "description": "DNS 重绑定：校验时解析到允许的地址，之后再解析会变成元数据地址——连接钉死校验过的 IP，不二次解析", "config": {"host": "rebind.test"}, "dns": {"rebind.test": ["127.0.0.1"]}, "dns_later": {"rebind.test": ["169.254.169.254"]}, "forbidden_ips": ["169.254.169.254"], "runs": [{"calls": [{"tool": "echo_query", "args": {"query": "a"}, "expect_ok": true, "expect_contains": "a"}, {"tool": "echo_query", "args": {"query": "b"}, "expect_ok": true, "expect_contains": "b"}], "expect_server": {"tools_call_processed": 2}}]}
{"id": "http-config-http-scheme", "category": "ssrf", "description": "明文 http:// 且未开 allow_private_network：加载期 MCP_CONFIG_INVALID，零请求", "config": {"scheme": "http", "allow_private_network": false}, "runs": [{"expect_config_error": "MCP_CONFIG_INVALID", "expect_server": {"no_requests": true}}]}
{"id": "http-config-userinfo", "category": "ssrf", "description": "URL 含 userinfo：加载期 MCP_CONFIG_INVALID", "config": {"userinfo": true}, "runs": [{"expect_config_error": "MCP_CONFIG_INVALID", "expect_server": {"no_requests": true}}]}
{"id": "http-bearer-ok", "category": "bearer", "description": "静态 Bearer：值来自槽位，每个 MCP 请求都带 Authorization，值不外泄", "server": {"mode": "bearer"}, "config": {"bearer_slot": "SERVER_API_KEY"}, "slots": {"SERVER_API_KEY": "static-bearer-token-0001"}, "runs": [{"expect_exposed": ["echo_query", "lookup_project", "session_probe"], "calls": [{"tool": "echo_query", "args": {"query": "管径"}, "expect_ok": true, "expect_contains": "管径"}], "expect_server": {"authorization_on_every_mcp_request": true, "tools_call_processed": 1}}]}
{"id": "http-bearer-slot-empty", "category": "bearer", "description": "槽位没填值：MCP_CREDENTIAL_MISSING，不发任何请求", "server": {"mode": "bearer"}, "config": {"bearer_slot": "SERVER_API_KEY"}, "runs": [{"expect_exposed": [], "expect_skips": {"*": "MCP_CREDENTIAL_MISSING"}, "expect_server": {"no_requests": true}}]}
{"id": "http-bearer-rejected", "category": "bearer", "description": "server 拒绝了静态 Bearer（401）：整台跳过 MCP_CONNECT_FAILED", "server": {"mode": "bearer"}, "config": {"bearer_slot": "SERVER_API_KEY"}, "slots": {"SERVER_API_KEY": "wrong-bearer-token-9999"}, "runs": [{"expect_exposed": [], "expect_skips": {"*": "MCP_CONNECT_FAILED"}}]}
{"id": "http-oauth-unauthorized", "category": "oauth", "description": "未授权：401 → MCP_OAUTH_REQUIRED，不请求任何授权端点", "server": {"mode": "oauth"}, "config": {"oauth": {}}, "runs": [{"expect_exposed": [], "expect_skips": {"*": "MCP_OAUTH_REQUIRED"}, "expect_authorized_after": false, "expect_server": {"token_requests": {}}}]}
{"id": "http-oauth-authorized-call", "category": "oauth", "description": "授权码 + PKCE + resource：授权后暴露并调用成功；令牌只发给 MCP endpoint", "server": {"mode": "oauth"}, "config": {"oauth": {}}, "runs": [{"before": [{"do": "authorize", "expect_authorized": true}], "expect_exposed": ["echo_query", "lookup_project", "session_probe"], "calls": [{"tool": "echo_query", "args": {"query": "管径"}, "expect_ok": true, "expect_contains": "管径"}], "expect_authorized_after": true, "expect_server": {"token_requests": {"authorization_code": 1}, "resource_and_verifier_sent": true, "authorization_only_on_mcp": true, "authorization_on_every_mcp_request": true, "tools_call_processed": 1}}]}
{"id": "http-oauth-discovery-fallback-path", "category": "oauth", "description": "401 不带 resource_metadata：回落到路径插入的 well-known", "server": {"mode": "oauth", "flags": ["--no-resource-metadata-header"]}, "config": {"oauth": {}}, "runs": [{"before": [{"do": "authorize", "expect_authorized": true}], "expect_exposed": ["echo_query", "lookup_project", "session_probe"], "expect_server": {"discovery_paths": ["/.well-known/oauth-protected-resource/mcp"]}}]}
{"id": "http-oauth-discovery-fallback-root", "category": "oauth", "description": "401 不带 resource_metadata 且路径元数据 404：再回落到根路径，按规范顺序", "server": {"mode": "oauth", "flags": ["--no-resource-metadata-header", "--root-metadata-only"]}, "config": {"oauth": {}}, "runs": [{"before": [{"do": "authorize", "expect_authorized": true}], "expect_exposed": ["echo_query", "lookup_project", "session_probe"], "expect_server": {"discovery_paths": ["/.well-known/oauth-protected-resource/mcp", "/.well-known/oauth-protected-resource"]}}]}
{"id": "http-oauth-no-pkce", "category": "oauth", "description": "授权服务器不声明 PKCE（缺 code_challenge_methods_supported）：拒绝继续 MCP_OAUTH_UNAVAILABLE", "server": {"mode": "oauth_no_pkce"}, "config": {"oauth": {}}, "runs": [{"before": [{"do": "authorize", "expect_error": "MCP_OAUTH_UNAVAILABLE", "expect_authorized": false}], "expect_server": {"token_requests": {}}}]}
{"id": "http-oauth-bad-iss", "category": "oauth", "description": "回调的 iss 不等于记录的 issuer：丢弃，不换令牌", "server": {"mode": "oauth_bad_iss"}, "config": {"oauth": {}}, "runs": [{"before": [{"do": "authorize", "expect_error": "MCP_OAUTH_REQUIRED", "expect_authorized": false}], "expect_server": {"token_requests": {}}}]}
{"id": "http-oauth-state-mismatch", "category": "oauth", "description": "回调 state 对不上服务端记录：丢弃，不换令牌", "server": {"mode": "oauth"}, "config": {"oauth": {}}, "runs": [{"before": [{"do": "authorize_wrong_state", "expect_error": "MCP_OAUTH_REQUIRED", "expect_authorized": false}], "expect_server": {"token_requests": {}}}]}
{"id": "http-oauth-token-refresh-rotation", "category": "oauth", "description": "访问令牌将过期时用 refresh token 刷新一次，轮换后的 refresh token 被替换（第二次刷新仍成功）", "server": {"mode": "oauth_expire"}, "config": {"oauth": {}}, "runs": [{"before": [{"do": "authorize", "expect_authorized": true}], "calls": [{"tool": "echo_query", "args": {"query": "a"}, "expect_ok": true, "expect_contains": "a"}]}, {"before": [{"do": "sleep", "seconds": 3.1}], "calls": [{"tool": "echo_query", "args": {"query": "b"}, "expect_ok": true, "expect_contains": "b"}]}, {"before": [{"do": "sleep", "seconds": 3.1}], "calls": [{"tool": "echo_query", "args": {"query": "c"}, "expect_ok": true, "expect_contains": "c"}], "expect_authorized_after": true, "expect_server": {"token_requests": {"authorization_code": 1, "refresh_token": 2}, "tools_call_processed": 3}}]}
{"id": "http-oauth-refresh-fails", "category": "oauth", "description": "刷新失败：清除令牌，MCP_OAUTH_REQUIRED，需管理员重新授权", "server": {"mode": "oauth_refresh_fail"}, "config": {"oauth": {}}, "runs": [{"before": [{"do": "authorize", "expect_authorized": true}], "calls": [{"tool": "echo_query", "args": {"query": "管径"}, "expect_ok": true, "expect_contains": "管径"}]}, {"before": [{"do": "sleep", "seconds": 3.1}], "expect_exposed": [], "expect_skips": {"*": "MCP_OAUTH_REQUIRED"}, "expect_authorized_after": false}]}
{"id": "http-oauth-insufficient-scope", "category": "oauth", "description": "403 insufficient_scope：如实报出所需 scope，不自动升级授权", "server": {"mode": "insufficient_scope"}, "config": {"oauth": {}}, "runs": [{"before": [{"do": "authorize", "expect_authorized": true}], "expect_exposed": ["echo_query", "lookup_project", "session_probe"], "calls": [{"tool": "echo_query", "args": {"query": "x"}, "expect_ok": false, "expect_code": "MCP_OAUTH_INSUFFICIENT_SCOPE", "expect_contains": "mcp:write"}], "expect_server": {"token_requests": {"authorization_code": 1}, "tools_call_processed": 0}}]}
{"id": "http-oauth-foreign-issuer", "category": "oauth", "description": "受保护资源元数据指向不在 allowed_issuers 里的授权服务器：MCP_OAUTH_UNAVAILABLE，不向它发任何请求", "server": {"mode": "oauth_foreign_issuer"}, "config": {"oauth": {}}, "runs": [{"before": [{"do": "authorize", "expect_error": "MCP_OAUTH_UNAVAILABLE", "expect_authorized": false}], "expect_server": {"token_requests": {}}}]}
{"id": "http-oauth-dynamic-registration", "category": "oauth", "description": "动态客户端注册（RFC 7591）：先注册再走授权码流程", "server": {"mode": "oauth", "flags": ["--dynamic-registration"]}, "config": {"oauth": {"client": "dynamic"}}, "runs": [{"before": [{"do": "authorize", "expect_authorized": true}], "expect_exposed": ["echo_query", "lookup_project", "session_probe"], "calls": [{"tool": "echo_query", "args": {"query": "管径"}, "expect_ok": true, "expect_contains": "管径"}], "expect_server": {"dynamic_registrations": 1, "token_requests": {"authorization_code": 1}}}]}
{"id": "http-oauth-client-secret-basic", "category": "oauth", "description": "预注册 + client_secret_basic：secret 来自槽位，不外泄", "server": {"mode": "oauth"}, "config": {"oauth": {"auth_method": "client_secret_basic"}}, "slots": {"OAUTH_CLIENT_SECRET": "wa-preregistered-secret-0001"}, "runs": [{"before": [{"do": "authorize", "expect_authorized": true}], "expect_exposed": ["echo_query", "lookup_project", "session_probe"], "calls": [{"tool": "echo_query", "args": {"query": "管径"}, "expect_ok": true, "expect_contains": "管径"}], "expect_server": {"token_requests": {"authorization_code": 1}}}]}
{"id": "http-oauth-revoke", "category": "oauth", "description": "撤销授权：删本地令牌（并尽力调用 revocation endpoint），之后再连 MCP_OAUTH_REQUIRED", "server": {"mode": "oauth"}, "config": {"oauth": {}}, "runs": [{"before": [{"do": "authorize", "expect_authorized": true}], "calls": [{"tool": "echo_query", "args": {"query": "管径"}, "expect_ok": true, "expect_contains": "管径"}]}, {"before": [{"do": "revoke", "expect_authorized": false}], "expect_exposed": [], "expect_skips": {"*": "MCP_OAUTH_REQUIRED"}, "expect_authorized_after": false}]}
{"id": "http-confirmation-session-refused", "category": "confirmation", "description": "human_confirmation=true 且入口没有确认门：整台不暴露，不连接", "config": {"human_confirmation": true}, "runs": [{"expect_exposed": [], "expect_skips": {"*": "MCP_CONFIRMATION_UNAVAILABLE"}, "expect_server": {"no_requests": true}}]}
{"id": "http-confirmation-web-exposed", "category": "confirmation", "description": "Web 入口接了确认门：human_confirmation=true 的 HTTP server 照常暴露（工具是延迟工具）", "entry": "web", "config": {"human_confirmation": true}, "runs": [{"expect_exposed": ["echo_query", "lookup_project", "session_probe"]}]}
{"id": "http-runner-basic", "category": "entry", "description": "评测 runner 的装配方式（owning + registry.invoke）：暴露并调用", "entry": "runner", "runs": [{"expect_exposed": ["echo_query", "lookup_project", "session_probe"], "expect_skips": {"nested_schema_tool": "MCP_UNSUPPORTED_SCHEMA", "unlisted_tool": "MCP_NOT_IN_ALLOWLIST"}, "calls": [{"tool": "echo_query", "args": {"query": "管径"}, "expect_ok": true, "expect_contains": "管径"}], "expect_server": {"tools_call_processed": 1}}]}
{"id": "http-runner-oauth", "category": "entry", "description": "runner 入口 + OAuth：授权后调用成功", "entry": "runner", "server": {"mode": "oauth"}, "config": {"oauth": {}}, "runs": [{"before": [{"do": "authorize", "expect_authorized": true}], "expect_exposed": ["echo_query", "lookup_project", "session_probe"], "calls": [{"tool": "echo_query", "args": {"query": "管径"}, "expect_ok": true, "expect_contains": "管径"}], "expect_server": {"authorization_on_every_mcp_request": true}}]}
{"id": "http-web-basic", "category": "entry", "description": "Web 入口（连接池租约，per_run）：暴露并调用", "entry": "web", "runs": [{"expect_exposed": ["echo_query", "lookup_project", "session_probe"], "expect_connection": "per_run", "calls": [{"tool": "echo_query", "args": {"query": "管径"}, "expect_ok": true, "expect_contains": "管径"}], "expect_server": {"tools_call_processed": 1}}]}
{"id": "http-web-shared-reuse", "category": "entry", "description": "Web 入口 shared：第二个 run 复用同一 MCP 会话（initialize 只一次，会话内计数累加）", "entry": "web", "config": {"lifecycle": "shared"}, "runs": [{"expect_connection": "shared_new", "calls": [{"tool": "session_probe", "expect_ok": true, "expect_fields": {"calls_in_session": 1}}]}, {"expect_connection": "shared_reused", "calls": [{"tool": "session_probe", "expect_ok": true, "expect_fields": {"calls_in_session": 2}}], "expect_server": {"initialize_count": 1, "tools_call_processed": 2}}]}
{"id": "http-web-oauth-shared", "category": "entry", "description": "Web 入口 + OAuth + shared：授权后复用连接，令牌刷新不换指纹", "entry": "web", "server": {"mode": "oauth"}, "config": {"oauth": {}, "lifecycle": "shared"}, "runs": [{"before": [{"do": "authorize", "expect_authorized": true}], "expect_connection": "shared_new", "calls": [{"tool": "echo_query", "args": {"query": "管径"}, "expect_ok": true, "expect_contains": "管径"}]}, {"expect_connection": "shared_reused", "calls": [{"tool": "echo_query", "args": {"query": "again"}, "expect_ok": true, "expect_contains": "again"}], "expect_server": {"initialize_count": 1, "token_requests": {"authorization_code": 1}, "tools_call_processed": 2}}]}
