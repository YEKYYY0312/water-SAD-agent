{
  "version": "p7-s8-2026-10-12",
  "servers": [
    {
      "server_id": "autocad_mcp",
      "command": "/path/to/autocad-mcp/.venv/bin/python",
      "args": [
        "-m",
        "autocad_mcp"
      ],
      "cwd": "/path/to/autocad-mcp",
      "transport": "stdio",
      "lifecycle": "shared",
      "env": {
        "AUTOCAD_MCP_BACKEND": "ezdxf"
      },
      "allow": [
        "read_dwg"
      ],
      "human_confirmation": false,
      "startup_timeout_seconds": 10.0,
      "call_timeout_seconds": 30.0,
      "max_response_bytes": 262144
    },
    {
      "server_id": "enterprise_library",
      "transport": "streamable_http",
      "url": "https://mcp.example.com/library/mcp",
      "credential_env": [
        "LIBRARY_API_KEY"
      ],
      "bearer_credential": "LIBRARY_API_KEY",
      "lifecycle": "shared",
      "allow": [
        "search_standards"
      ],
      "disabled": true,
      "call_timeout_seconds": 30.0,
      "max_response_bytes": 262144
    },
    {
      "server_id": "cad_cloud",
      "transport": "streamable_http",
      "url": "https://mcp.example.com/cad/mcp",
      "credential_env": [
        "CAD_OAUTH_CLIENT_SECRET"
      ],
      "oauth": {
        "client_id": "water-agent-prod",
        "client_secret_credential": "CAD_OAUTH_CLIENT_SECRET",
        "token_endpoint_auth_method": "client_secret_basic",
        "allowed_issuers": [
          "https://auth.example.com"
        ]
      },
      "allow": [
        "read_drawing_metadata"
      ],
      "human_confirmation": true,
      "disabled": true
    }
  ]
}
